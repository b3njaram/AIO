# syntax=docker/dockerfile:1
ARG BASE_IMAGE=postgres:17-alpine@sha256:f9cf3e1f0066f0eb0c48707d864f0ac5941e9ff454a072077d97a4d278d07d73
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
ADD --checksum=sha256:2b70da8a5480fafedc16bb1fc91b572f064d03df736cbd91a616af2f1b66ab51 https://codeload.github.com/tianon/gosu/tar.gz/29b939aa5bd4dc588af765b8248f6e39150d2565 /tmp/gosu.tgz
ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN tar -xzf /tmp/gosu.tgz --strip-components=1 && \
    printf '%s\n' 'golang.org/x/sys v0.44.0 h1:ildZl3J4uzeKP07r2F++Op7E9B29JRUy+a27EibtBTQ=' \
      'golang.org/x/sys v0.44.0/go.mod h1:4GL1E5IUh+htKOUEOaiffhrAeqysfVGipDYzABqnCmw=' >> go.sum && \
    go get golang.org/x/sys@v0.44.0 && go mod download && go mod verify
RUN --network=none go build -mod=readonly -trimpath -ldflags='-d -w' -o /out/gosu .
FROM ${BASE_IMAGE} AS runtime
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 CMD pg_isready -h 127.0.0.1 -U "${POSTGRES_USER:-postgres}" -d "${POSTGRES_DB:-postgres}"
COPY --from=build --chmod=0755 /out/gosu /usr/local/bin/gosu
RUN test "$(gosu postgres id -u)" = "$(id -u postgres)" && \
    test "$(gosu postgres id -g)" = "$(id -g postgres)" && gosu postgres postgres --version

FROM runtime AS debian_patched
ARG DEBIAN_CODENAME
ARG PACKAGE_FLOORS
RUN --mount=type=bind,from=build,source=/etc/ssl/certs/ca-certificates.crt,target=/tmp/jobbi-build-ca.pem,ro \
    --mount=type=bind,source=debian-patch.sh,target=/tmp/jobbi-patch.sh,ro \
    sh /tmp/jobbi-patch.sh "$DEBIAN_CODENAME" "$PACKAGE_FLOORS"

FROM runtime AS alpine_patched
RUN --mount=type=bind,source=alpine-patch.sh,target=/tmp/jobbi-patch.sh,ro \
    sh /tmp/jobbi-patch.sh 'libxml2=2.13.9-r3'
