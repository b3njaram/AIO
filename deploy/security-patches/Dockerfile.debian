# syntax=docker/dockerfile:1
# Keep upstream runtime, entrypoint, user, application version and data format.
ARG BASE_IMAGE
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build_trust
FROM ${BASE_IMAGE} AS patched
ARG DEBIAN_CODENAME
ARG PACKAGE_FLOORS
RUN --mount=type=bind,from=build_trust,source=/etc/ssl/certs/ca-certificates.crt,target=/tmp/jobbi-build-ca.pem,ro \
    --mount=type=bind,source=debian-patch.sh,target=/tmp/jobbi-patch.sh,ro \
    /bin/sh /tmp/jobbi-patch.sh "$DEBIAN_CODENAME" "$PACKAGE_FLOORS"

FROM patched AS machine_learning
RUN --mount=type=bind,source=immich-ml-requirements.txt,target=/tmp/requirements.txt,ro \
    /usr/local/bin/python -m pip --python /opt/venv install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r /tmp/requirements.txt
RUN --network=none --mount=type=bind,source=check-ml.py,target=/tmp/check-ml.py,ro \
    /usr/local/bin/python -m pip --python /opt/venv check && /opt/venv/bin/python /tmp/check-ml.py

# Keep Immich on the same PostgreSQL package vendor and major version.
FROM patched AS immich_server
ADD --chmod=0644 --checksum=sha256:0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76 https://www.postgresql.org/media/keys/ACCC4CF8.asc /tmp/jobbi-pgdg.asc
RUN --mount=type=bind,from=build_trust,source=/etc/ssl/certs/ca-certificates.crt,target=/tmp/jobbi-build-ca.pem,ro <<'SH'
set -eu
. /etc/os-release
test "$VERSION_CODENAME" = trixie
version=17.12-1.pgdg13+1
installed=$(dpkg-query -W -f='${Version}' postgresql-client-17)
case "$installed" in 17.*.pgdg13+*) ;; *) exit 1;; esac
dpkg --compare-versions "$version" ge "$installed"
printf '%s\n' 'deb [signed-by=/tmp/jobbi-pgdg.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main' >/tmp/jobbi-pgdg.list
set -- -o Dir::Etc::sourcelist=/tmp/jobbi-pgdg.list -o Dir::Etc::sourceparts=- \
    -o Acquire::https::CaInfo=/tmp/jobbi-build-ca.pem -o Acquire::Retries=4 -o APT::Update::Error-Mode=any
apt-get "$@" update
DEBIAN_FRONTEND=noninteractive apt-get "$@" install -y --only-upgrade --no-remove --no-install-recommends "postgresql-client-17=$version"
test "$(dpkg-query -W -f='${Version}' postgresql-client-17)" = "$version"
pg_dump --version
psql --version
rm -rf /var/lib/apt/lists/* /tmp/jobbi-pgdg.list /tmp/jobbi-pgdg.asc
SH

# Same-major replacements in exact installed pnpm and npm package directories.
# Preserve native modules, symlinks, upstream application and storage schema.
RUN --mount=type=bind,source=patch-immich-npm.cjs,target=/tmp/jobbi-immich-npm.cjs,ro \
    --mount=type=bind,source=immich-npm-security.json,target=/tmp/jobbi-immich-npm.json,ro \
    node /tmp/jobbi-immich-npm.cjs /tmp/jobbi-immich-npm.json

FROM patched AS application
